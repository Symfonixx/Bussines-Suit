{
  "name": "Symfonix Business Suite",
  "install": "./.cursor/install.sh",
  "start": "./.cursor/start.sh",
  "terminals": [
    {
      "name": "serve",
      "command": "php artisan serve --host=0.0.0.0 --port=8000"
    },
    {
      "name": "vite",
      "command": "npm run dev"
    },
    {
      "name": "queue",
      "command": "php artisan queue:work --tries=1 --timeout=0"
    }
  ],
  "ports": [8000, 5173]
}
